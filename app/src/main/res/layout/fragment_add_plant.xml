<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F5F9F0">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Add New Plant"
            android:textSize="20sp"
            android:textStyle="bold"
            android:textColor="#2D6A2D"
            android:layout_marginBottom="16dp"/>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Species Name *"
            android:textSize="12sp"
            android:textColor="#888888"/>

        <EditText
            android:id="@+id/etPlantName"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="e.g. Neem, Peepal, Mango"
            android:layout_marginBottom="12dp"/>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Area / Location"
            android:textSize="12sp"
            android:textColor="#888888"/>

        <EditText
            android:id="@+id/etAreaName"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="e.g. HSR Layout, near school"
            android:layout_marginBottom="12dp"/>

        <TextView
            android:id="@+id/tvGpsCoords"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="GPS: not fetched yet"
            android:textColor="#888888"
            android:textSize="12sp"/>

        <Button
            android:id="@+id/btnGetLocation"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Get GPS Location"
            android:backgroundTint="#A8D5A2"
            android:layout_marginTop="8dp"
            android:layout_marginBottom="12dp"/>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Notes (optional)"
            android:textSize="12sp"
            android:textColor="#888888"/>

        <EditText
            android:id="@+id/etNotes"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Soil type, extra notes..."
            android:layout_marginBottom="20dp"/>

        <Button
            android:id="@+id/btnSavePlant"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Save Plant Record"
            android:backgroundTint="#2D6A2D"
            android:textColor="#FFFFFF"/>

    </LinearLayout>
</ScrollView>
